# Configuration contract for the planned application, not a runnable deployment yet.
# Never put server secrets in VITE_* variables or commit a populated .env file.

# Supplied through local environment / secret storage, not chat.
OPENAI_API_KEY=
# Required when EVIDENCE_PROVIDER=jev, and for Jev confidence scoring and web discovery.
# When set, Jev confidence is a hard dependency of answers: import the JEV_MODEL prices first.
# Never used as an automatic fallback.
TYPESAFE_API_KEY=
# TinyFish Search/Fetch for web discovery (free daily allowance). Server-side only.
TINYFISH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Generated locally at setup. The database must be dedicated to this application.
DATABASE_URL=
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
INTERNAL_AUTH_SECRET=
# Migration identities are distinct from runtime identities; unset outside setup.
NOTI_MIGRATION_URL=
NOTI_AUTH_MIGRATION_URL=

# Non-secret settings. Validate the chat model against account availability first.
APP_ORIGIN=http://localhost:3000
# Proposed production listeners; check availability again before rollout.
API_BIND_ADDRESS=127.0.0.1:3810
AUTH_BIND_HOST=127.0.0.1
AUTH_PORT=3811
AUTH_INTERNAL_URL=http://127.0.0.1:3811
WEB_DIST_DIR=./apps/web/dist
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Exact pinned model: jev-1.14.0 (default) or jev-1.13.0. Aliases are rejected.
JEV_MODEL=jev-1.14.0
# Application self-limits below the TinyFish free allowance (UTC day, all institutions).
TINYFISH_DAILY_SEARCH_LIMIT=1000
TINYFISH_DAILY_FETCH_LIMIT=300
# Each institution's (school or personal space) share per UTC day, in addition to the limits above.
TINYFISH_DAILY_SEARCH_LIMIT_PER_SPACE=200
TINYFISH_DAILY_FETCH_LIMIT_PER_SPACE=60
# Web passages below this Jev overall confidence are dropped.
WEB_EVIDENCE_MIN_CONFIDENCE=0.6
# Extracted relations from approved sources at or above this Jev confidence are auto-approved.
GRAPH_AUTO_APPROVE=0.9
AI_MONTHLY_BUDGET_USD=50
AI_LIVE_CALLS_ENABLED=false
AI_MODE=disabled
EVIDENCE_PROVIDER=openai
EMBEDDING_DIMENSIONS=1536
UPLOAD_DIR=./data/uploads
REGISTRATION_MODE=invite_only
