# Configuration contract for the planned application, not a runnable deployment yet.
# Never put server secrets in VITE_* variables or commit a populated .env file.

# Supplied through local environment / secret storage, not chat.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls

# Generated locally at setup. The database must be dedicated to this application.
DATABASE_URL=
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
INTERNAL_AUTH_SECRET=
# Migration identities are distinct from runtime identities; unset outside setup.
NOTI_MIGRATION_URL=
NOTI_AUTH_MIGRATION_URL=

# Non-secret settings. Validate the chat model against account availability first.
APP_ORIGIN=http://localhost:3000
# Proposed production listeners; check availability again before rollout.
API_BIND_ADDRESS=127.0.0.1:3810
AUTH_BIND_HOST=127.0.0.1
AUTH_PORT=3811
AUTH_INTERNAL_URL=http://127.0.0.1:3811
WEB_DIST_DIR=./apps/web/dist
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
JEV_MODEL=jev-1.13.0
AI_MONTHLY_BUDGET_USD=50
AI_LIVE_CALLS_ENABLED=false
AI_MODE=disabled
EMBEDDING_DIMENSIONS=1536
UPLOAD_DIR=./data/uploads
REGISTRATION_MODE=invite_only
