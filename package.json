{
  "name": "noti-school", "version": "0.1.0", "private": true, "type": "module",
  "packageManager": "pnpm@10.29.2", "engines": { "node": ">=24.18.0 <25", "pnpm": "10.29.2" },
  "scripts": {
    "test": "tsx --test tests/foundation/*.test.ts",
    "typecheck": "tsc -p tsconfig.base.json",
    "contracts:generate": "tsx scripts/contracts.ts --write",
    "contracts:check": "tsx scripts/contracts.ts",
    "env:check": "tsx scripts/env-check.ts",
    "check": "pnpm typecheck && pnpm contracts:check && pnpm test",
    "build": "node scripts/apps.mjs build",
    "setup:check": "node scripts/apps.mjs prerequisites",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test": "tsx scripts/db-test.ts",
    "db:auth:migrate": "tsx scripts/auth-migrate.ts",
    "operator": "tsx scripts/operator.ts",
    "test:integration": "tsc -p tests/integration/tsconfig.json && tsx --test tests/integration/*.test.ts",
    "infra:check": "node scripts/infra-check.mjs"
  },
  "devDependencies": { "@types/node": "24.13.6", "@types/pg": "8.20.0", "ajv": "8.20.0", "ajv-formats": "3.0.1", "pg": "8.23.0", "pgsql-parser": "18.2.8", "tsx": "4.23.15", "typescript": "7.0.2", "yaml": "2.9.1", "zod": "4.6.6", "better-auth": "1.7.7" }
}
